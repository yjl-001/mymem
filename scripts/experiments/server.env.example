# Copy this file to scripts/experiments/.server.env on the training server,
# then replace every value with the server-local path or device assignment.
# Do not commit .server.env: it is deliberately ignored.

export MEMGEN_OUTPUT_ROOT="/data/memgen-runs"
export MEMGEN_DEVICES="0"
export MEMGEN_GSM8K_WEAVER_CKPT="/data/memgen-runs/train/gsm8k/<weaver-sft-run>/model"

# Offline teacher used only to construct inspectable experience-bank records.
# Put the real key only in scripts/experiments/.server.env, never in Git.
export DEEPSEEK_API_KEY=""
export DEEPSEEK_MODEL="deepseek-v4-pro"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
# JSON-mode bank construction defaults to disabled for reliable final JSON.
export DEEPSEEK_THINKING="disabled"
