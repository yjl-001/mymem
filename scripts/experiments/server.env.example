# Copy this file to scripts/experiments/.server.env on the training server,
# then replace every value with the server-local path or device assignment.
# Do not commit .server.env: it is deliberately ignored.

export MEMGEN_OUTPUT_ROOT="/data/memgen-runs"
export MEMGEN_DEVICES="0"
export MEMGEN_GSM8K_WEAVER_CKPT="/data/memgen-runs/train/gsm8k/<weaver-sft-run>/model"

# Frozen student and sampling budget for the Phase 1 verified rollout bank.
export MEMGEN_GSM8K_STUDENT_MODEL="Qwen/Qwen2.5-1.5B-Instruct"
export MEMGEN_GSM8K_STUDENT_REVISION="main"
export MEMGEN_GSM8K_DATASET_REVISION="main"
export MEMGEN_GSM8K_BANK_SOURCE_SIZE="6000"
export MEMGEN_GSM8K_CALIBRATION_VAL_SIZE="1000"
export MEMGEN_PHASE1_ROLLOUT_SAMPLE_LIMIT="0"
export MEMGEN_PHASE1_ROLLOUTS_PER_SAMPLE="8"
export MEMGEN_PHASE1_ROLLOUT_BATCH_SIZE="8"
export MEMGEN_PHASE1_MAX_NEW_TOKENS="768"
export MEMGEN_PHASE1_TEMPERATURE="0.8"
export MEMGEN_PHASE1_TOP_P="0.95"
export MEMGEN_PHASE1_SEED="42"
export MEMGEN_PHASE1_ATTN_IMPLEMENTATION="flash_attention_2"
# 0 reflects every verified contrast; use a positive value only for a cost-bounded dry run.
export MEMGEN_PHASE1_TEACHER_LIMIT="0"

# Phase 2: no-new-AI vector-construction ablation.  It uses only the frozen
# Phase 1 ai_approved bank; no DeepSeek credentials or second-pass anchoring
# are involved. The default 100/100 calibration split is an economical first
# run. Evaluation needs eager attention to expose attention weights for
# sink-masked entropy.
export MEMGEN_PHASE2_LAYERS="8,16,24"
# The formal Phase 2 primary vector is answer correctness only. Other failure
# types retain their Phase 1 bank records but are not mixed into this vector.
export MEMGEN_PHASE2_EXPERIENCE_TYPES="answer_correctness"
export MEMGEN_PHASE2_ABLATION_METHODS="pair_normalized_delta,global_centroid_delta,mechanism_balanced_centroid_delta,seal_style_execution_minus_nonexecution"
export MEMGEN_PHASE2_MIN_EVIDENCE_COUNT="50"
export MEMGEN_PHASE2_MIN_CLUSTER_EVIDENCE_COUNT="25"
# Entropy-recovery Phase 2: offline source states use the same sink-masked
# high-entropy condition as online insertion. The low quantile defines whether
# the next reasoning boundary has recovered/converged.
export MEMGEN_PHASE2_RECOVERY_METHODS="entropy_recovery_state_delta,entropy_recovery_displacement_delta"
export MEMGEN_PHASE2_RECOVERY_HIGH_ENTROPY_QUANTILE="0.85"
export MEMGEN_PHASE2_RECOVERY_LOW_ENTROPY_QUANTILE="0.50"
export MEMGEN_PHASE2_RECOVERY_MIN_EVENTS="50"
export MEMGEN_PHASE2_RECOVERY_EVAL_MIN_EVENTS="10"
# Minimal Phase-2 entropy-risk probe: no hyperparameter grid.  A bank-heldout
# diagnostic must pass before any online injection is evaluated on dev-test.
export MEMGEN_PHASE2_RISK_LAYER="24"
export MEMGEN_PHASE2_RISK_HIGH_ENTROPY_QUANTILE="0.85"
export MEMGEN_PHASE2_RISK_LOW_ENTROPY_QUANTILE="0.50"
export MEMGEN_PHASE2_RISK_TRAIN_FRACTION="0.50"
export MEMGEN_PHASE2_RISK_SPLIT_SEED="42"
export MEMGEN_PHASE2_RISK_MIN_EVENTS="50"
export MEMGEN_PHASE2_RISK_MIN_AUC="0.60"
export MEMGEN_PHASE2_RISK_EVAL_SPLIT="dev-test"
# Keep 0 for an exploratory smoke run.  After inspecting a smoke prefix,
# confirm on an untouched suffix (for example offset=100) without changing any
# intervention parameter.
export MEMGEN_PHASE2_RISK_EVAL_OFFSET="0"
export MEMGEN_PHASE2_RISK_EVAL_LIMIT="100"
export MEMGEN_PHASE2_RISK_ALPHA="0.05"
export MEMGEN_PHASE2_RISK_GATE_SLOPE="0.10"
export MEMGEN_PHASE2_RISK_BOOTSTRAP_RESAMPLES="10000"
export MEMGEN_PHASE2_RISK_MIN_PAIRED_EVENTS="50"
export MEMGEN_PHASE2_COMPILER_BATCH_SIZE="2"
export MEMGEN_PHASE2_COMPILER_LIMIT="0"
export MEMGEN_PHASE2_COMPILER_ATTN_IMPLEMENTATION="flash_attention_2"
export MEMGEN_PHASE2_EVAL_ATTN_IMPLEMENTATION="eager"
export MEMGEN_PHASE2_DTYPE="bfloat16"
export MEMGEN_PHASE2_ALPHAS="0.02,0.05"
export MEMGEN_PHASE2_GATE_SLOPES="0.10,0.25"
export MEMGEN_PHASE2_MAX_INJECTIONS_GRID="2"
export MEMGEN_PHASE2_ENTROPY_QUANTILE="0.85"
export MEMGEN_PHASE2_TUNE_SIZE="100"
export MEMGEN_PHASE2_CONFIRM_SIZE="100"
export MEMGEN_PHASE2_MAX_NEW_TOKENS="768"
export MEMGEN_PHASE2_R_MAX="0.10"
export MEMGEN_PHASE2_SINK_TOKEN_COUNT="4"
export MEMGEN_PHASE2_SEED="42"

# Offline teacher used only to construct inspectable experience-bank records.
# Put the real key only in scripts/experiments/.server.env, never in Git.
export DEEPSEEK_API_KEY=""
# Use a cheaper model for abstraction and a stronger independent model for review.
# Override these names if the API gateway exposes different aliases.
export DEEPSEEK_TEACHER_MODEL="deepseek-v4-flash"
export DEEPSEEK_REVIEW_MODEL="deepseek-v4-pro"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
# JSON-mode bank construction defaults to disabled for reliable final JSON.
export DEEPSEEK_THINKING="disabled"
export DEEPSEEK_REVIEW_THINKING="disabled"

# Persistent teacher client and enterprise-proxy recovery. With the defaults,
# repeated HTTP 407/CONNECT failures are retried for roughly 90 minutes using
# 30, 60, 120, 240, then capped 300 second waits.
export MEMGEN_TEACHER_PROXY_RETRIES="20"
export MEMGEN_TEACHER_PROXY_RETRY_INITIAL_SECONDS="30"
export MEMGEN_TEACHER_PROXY_RETRY_MAX_SECONDS="300"
export MEMGEN_TEACHER_CONNECT_TIMEOUT_SECONDS="30"
export MEMGEN_TEACHER_READ_TIMEOUT_SECONDS="180"
